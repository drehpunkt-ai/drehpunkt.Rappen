msgstr "Le fichier ne contient aucun relevé."

msgid "The file contains statements of more than one account."
msgstr "Le fichier contient des relevés de plusieurs comptes."

msgid "The file does not contain a bank statement or notification."
msgstr "Le fichier ne contient ni relevé ni avis."

msgid "The file is for the account {0}, but Bank Account {1} has a different IBAN."
msgstr "Le fichier concerne le compte {0}, mais le compte bancaire {1} a un autre IBAN."

msgid "The file is larger than 50 MB."
msgstr "Le fichier dépasse 50 Mo."

msgid "The file is not valid XML: {error}"
msgstr "Le fichier n'est pas un XML valable : {error}"

msgid "The generated file does not match the schema {schema}: line {line}, {detail}"
msgstr "Le fichier généré ne correspond pas au schéma {schema} : ligne {line}, {detail}"

