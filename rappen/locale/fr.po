msgstr "Chiffre d'affaires par taux"

msgid "Turnover without VAT, to be assigned"
msgstr "Chiffre d'affaires sans TVA, à attribuer"

msgid "Type of submission"
msgstr "Type de dépôt"

msgid "UID"
msgstr "IDE"

msgid "UID {uid} is invalid: the check digit does not match."
msgstr "L'IDE {uid} n'est pas valable : le chiffre de contrôle ne correspond pas."

msgid "Unknown VAT method {method}."
msgstr "Méthode TVA inconnue {method}."

msgid "Upload this file in the ESTV ePortal."
msgstr "Chargez ce fichier dans l'ePortal de l'AFC."

msgid "Upload this file in your e-banking."
msgstr "Chargez ce fichier dans votre e-banking."

msgid "Used by «Get open purchase invoices»."
msgstr "Utilisé par «Récupérer les factures fournisseurs ouvertes»."

msgid "Various deductions (280)"
msgstr "Divers (280)"

