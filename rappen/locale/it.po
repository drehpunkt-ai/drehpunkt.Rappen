msgid "The amount of a QR-bill is between 0.01 and 999999999.99, {amount} is not."
msgstr "L'importo di una QR-fattura è compreso tra 0.01 e 999999999.99, {amount} no."

msgid "The amount of payment {id} must be positive."
msgstr "L'importo del pagamento {id} deve essere positivo."

msgid "The amount {amount} is not a number."
msgstr "L'importo {amount} non è un numero."

msgid "The batch entry of these payments is reconciled already, so they are not imported again."
msgstr "La registrazione collettiva di questi pagamenti è già riconciliata, quindi non vengono importati di nuovo."

msgid "The content of the QR code has {length} characters, at most {limit} are allowed."
msgstr "Il contenuto del codice QR ha {length} caratteri, ne sono ammessi al massimo {limit}."

msgid "The country is missing in the address of {name}."
msgstr "Nell'indirizzo di {name} manca il paese."

msgid "The creditor is missing in the QR code."
msgstr "Nel codice QR manca il creditore."

msgid "The end-to-end ID {id} needs 1 to 35 letters, digits or separators."
msgstr "L'ID end-to-end {id} deve avere da 1 a 35 lettere, cifre o separatori."

msgid "The execution date lies in the past."
msgstr "La data di esecuzione è nel passato."

msgid "The file contains a document type declaration, which camt files never have."
msgstr "Il file contiene una dichiarazione del tipo di documento, che i file camt non hanno mai."

msgid "The file contains no statement."
msgstr "Il file non contiene alcun estratto."

msgid "The file contains statements of more than one account."
msgstr "Il file contiene estratti di più di un conto."

msgid "The file does not contain a bank statement or notification."
msgstr "Il file non contiene né un estratto conto né un avviso."

msgid "The file is for the account {0}, but Bank Account {1} has a different IBAN."
msgstr "Il file riguarda il conto {0}, ma il conto bancario {1} ha un altro IBAN."

msgid "The file is larger than 50 MB."
msgstr "Il file supera i 50 MB."

msgid "The file is not valid XML: {error}"
msgstr "Il file non è un XML valido: {error}"

msgid "The generated file does not match the schema {schema}: line {line}, {detail}"
msgstr "Il file generato non corrisponde allo schema {schema}: riga {line}, {detail}"

msgid "The message ID {id} needs 1 to 35 letters, digits or separators."
msgstr "L'ID del messaggio {id} deve avere da 1 a 35 lettere, cifre o separatori."

msgid "The message of payment {id} is longer than 140 characters."
msgstr "Il messaggio del pagamento {id} supera i 140 caratteri."

msgid "The name is missing in the address."
msgstr "Nell'indirizzo manca il nome."

msgid "The name {name} is too long: {length} characters, at most {limit} are allowed."
msgstr "Il nome {name} è troppo lungo: {length} caratteri, ne sono ammessi al massimo {limit}."

msgid "The net tax rate method allows at most two net tax rates."
msgstr "Il metodo delle aliquote saldo ammette al massimo due aliquote saldo."

msgid "The payment proposal contains no payments."
msgstr "La proposta di pagamento non contiene pagamenti."

msgid "The payment run contains no payments."
msgstr "Il ciclo di pagamento non contiene pagamenti."

msgid "The period ends before it starts."
msgstr "Il periodo termina prima di iniziare."

msgid "The postal code is missing in the address of {name}."
msgstr "Nell'indirizzo di {name} manca il numero postale."

msgid "The postal code {postal_code} is too long: at most {limit} characters are allowed."
msgstr "Il numero postale {postal_code} è troppo lungo: sono ammessi al massimo {limit} caratteri."

msgid "The QR code content is incomplete: the trailer EPD is missing."
msgstr "Il contenuto del codice QR è incompleto: manca la chiusura EPD."

msgid "The QR code declares reference type {declared}, but its reference is of type {actual}."
msgstr "Il codice QR indica il tipo di riferimento {declared}, ma il riferimento è del tipo {actual}."

msgid "The QR code would need version {version}, at most 25 is allowed. Shorten the texts."
msgstr "Il codice QR richiederebbe la versione {version}, è ammessa al massimo la 25. Accorciare i testi."

msgid "The QR reference prefix consists of digits only, at most {0} of them."
msgstr "Il prefisso del riferimento QR contiene solo cifre, al massimo {0}."

msgid "The QR-bill asks for {0} {1}, the invoice totals {0} {2}."
msgstr "La QR-fattura chiede {0} {1}, la fattura ammonta a {0} {2}."

msgid "The QR-bill is in {0}, the invoice in {1}."
msgstr "La QR-fattura è in {0}, la fattura in {1}."

msgid "The QR-bill uses an unstructured address (type {type}), which is no longer valid. Ask the creditor for a new QR-bill."
msgstr "La QR-fattura utilizza un indirizzo non strutturato (tipo {type}), che non è più valido. Chiedere una nuova QR-fattura al creditore."

msgid "The single payments of this batch were imported already."
msgstr "I singoli pagamenti di questa registrazione collettiva sono già stati importati."

msgid "The street {street} is too long: {length} characters, at most {limit} are allowed."
msgstr "La via {street} è troppo lunga: {length} caratteri, ne sono ammessi al massimo {limit}."

msgid "The taxable turnover (box 299: {taxable}) must equal the turnover at the tax rates ({at_rates}). Assign the difference to exports, supplies abroad, exempt supplies or deductions."
msgstr "La cifra d'affari imponibile (cifra 299: {taxable}) deve corrispondere alla cifra d'affari alle aliquote ({at_rates}). Attribuire la differenza alle esportazioni, alle prestazioni all'estero, alle prestazioni escluse o alle deduzioni."

msgid "The town is missing in the address of {name}."
msgstr "Nell'indirizzo di {name} manca la località."

msgid "The town {town} is too long: {length} characters, at most {limit} are allowed."
msgstr "La località {town} è troppo lunga: {length} caratteri, ne sono ammessi al massimo {limit}."

msgid "This file has been imported already."
msgstr "Questo file è già stato importato."

msgid "This is how the address appears on QR-bills and in payment files."
msgstr "Ecco come appare l'indirizzo sulle QR-fatture e nei file di pagamento."

msgid "This is not a camt.052, camt.053 or camt.054 file in version 001.04 to 001.08 ({namespace})."
msgstr "Questo non è un file camt.052, camt.053 o camt.054 nella versione da 001.04 a 001.08 ({namespace})."

msgid "This is not the content of a Swiss QR Code."
msgstr "Questo non è il contenuto di uno Swiss QR Code."

msgid "This QR-bill cannot be paid:"
msgstr "Questa QR-fattura non può essere pagata:"

