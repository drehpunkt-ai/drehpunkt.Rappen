msgstr "Il conto bancario {0} non appartiene all'azienda {1}."

msgid "Bank entry reference"
msgstr "Riferimento della registrazione bancaria"

msgid "Bank Transaction {0} has no matching document."
msgstr "La transazione bancaria {0} non ha un documento corrispondente."

msgid "Bank Transaction {0} is reconciled already."
msgstr "La transazione bancaria {0} è già riconciliata."

msgid "Bank transactions created"
msgstr "Transazioni bancarie create"

msgid "Batch of {0} payments"
msgstr "Registrazione collettiva di {0} pagamenti"

msgid "Book exact matches automatically"
msgstr "Registrare automaticamente le corrispondenze esatte"

msgid "Book payment against {0}"
msgstr "Registrare il pagamento su {0}"

msgid "Booked automatically"
msgstr "Registrate automaticamente"

msgid "Booking date"
msgstr "Data di registrazione"

