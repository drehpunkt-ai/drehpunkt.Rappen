msgstr "Transazione dell'importazione camt"

msgid "camt.053 (statement) or camt.054 (notification), version 001.04 to 001.08, as XML."
msgstr "camt.053 (estratto conto) o camt.054 (avviso di accredito o addebito), versione da 001.04 a 001.08, in XML."

msgctxt "Rappen"
msgid "Cancelled"
msgstr "Annullato"

msgid "Closing balance"
msgstr "Saldo finale"

msgctxt "Rappen"
msgid "Country"
msgstr "Paese"

msgid "Country code {country} is invalid, it needs two letters (ISO 3166-1)."
msgstr "Il codice del paese {country} non è valido, deve avere due lettere (ISO 3166-1)."

msgctxt "Rappen"
msgid "Credit note"
msgstr "Nota di credito"

msgid "Creditor Reference {reference} is invalid: the check digits do not match."
msgstr "La Creditor Reference {reference} non è valida: le cifre di controllo non corrispondono."

msgctxt "Rappen"
msgid "Customer number"
msgstr "Numero cliente"

msgctxt "Rappen"
msgid "Date"
msgstr "Data"

msgctxt "Rappen"
msgid "Days overdue"
msgstr "Giorni di ritardo"

